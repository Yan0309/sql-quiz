# Copy to .env (which is git-ignored) and fill in. Never commit .env.
# All database URLs use the Supabase *Session pooler* (port 5432) with sslmode=require.
# URL-encode special characters in passwords (@ -> %40, # -> %23, / -> %2F, : -> %3A).

# --- used by scripts/setup_db.py and scripts/check_quiz.py (same names as the GitHub Secrets)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
QUIZ_TAKER_PASSWORD=choose-a-long-random-password
QUIZ_APP_PASSWORD=choose-a-different-long-random-password

# --- used by app.py (streamlit run app.py)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_KEY=sb_publishable_xxx_or_legacy_anon_key
TAKER_DATABASE_URL=postgresql://quiz_taker.YOUR_PROJECT_REF:QUIZ_TAKER_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
APP_DATABASE_URL=postgresql://quiz_app.YOUR_PROJECT_REF:QUIZ_APP_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres?sslmode=require
